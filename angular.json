{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "odontocare-hcu": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "**/*", "input": "src/assets", "output": "assets" }
            ],
            "styles": ["src/styles.css"]
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "odontocare-hcu:build" } }
      }
    }
  },
  "cli": {
    "analytics": "ed916094-34a0-4b3c-a6a0-7a88fbacf7a6"
  }
}
